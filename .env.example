# RiceGuard AI: fill OPENAI_API_KEY in .env, then restart the local server.
# Server-only. Never use a VITE_ prefix for an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional alternative provider for the older Climate Monitor analysis button.
# When blank, that button also uses the OpenAI settings above.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
