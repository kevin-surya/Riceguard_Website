{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "{src/data.json,src/research.json,public/research/spatio-timeline.json}"
    },
    "api/chat/status.js": {
      "maxDuration": 10
    },
    "api/analyze.js": {
      "maxDuration": 60
    }
  }
}
